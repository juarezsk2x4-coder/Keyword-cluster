# Turso (libSQL) connection for production.
# When TURSO_DATABASE_URL is unset, the app falls back to a local SQLite file
# at ./data/app.db (only works on a machine with persistent disk — NOT on Vercel).
#
# To set up Turso (free):
#   1. Sign up at https://turso.tech (GitHub login).
#   2. Create a database (1 click).
#   3. Click "Show credentials" -> copy the URL and Auth Token.
#   4. Paste them into Vercel's "Environment Variables" page (Settings > Environment Variables).
#   5. Redeploy. The schema auto-creates on first request.

TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=eyJhbG...your-long-token...

# Anthropic API key for AI nutrition estimation (optional but recommended).
# Used by the "Estimate nutrition with AI" button when logging a free-text meal.
# Without it, the button shows "AI not configured" and you fill kcal/protein manually.
#
# To get a key:
#   1. Sign up at https://console.anthropic.com
#   2. Create an API key in Settings -> API Keys
#   3. Paste it into Vercel Environment Variables
#   4. Redeploy

ANTHROPIC_API_KEY=sk-ant-api03-...your-key...

# Secret shared by anyone with the calendar-subscription URL on the Profile
# page (optional). Without it, /api/calendar/[person]/... always returns
# 401 and the Profile page shows "not configured" instead of a URL — the
# feed is disabled by default, not exposed with a guessable/default token.
#
# Generate any long random string yourself, e.g.:
#   openssl rand -hex 32
# Paste it into Vercel Environment Variables. The same value goes in the
# URL's ?token= query param automatically once set — nothing else to wire up.

CALENDAR_FEED_TOKEN=
